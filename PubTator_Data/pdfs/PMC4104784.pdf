      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Environmental enrichment alters protein expression as well as the proteomic response to cocaine in rat nucleus accumbens</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Thomas A. Green</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Prior research demonstrated that environmental enrichment creates individual differences in behavior leading to a protective addiction phenotype in rats.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>differential rearing</rdf:li>
               <rdf:li>drug addiction</rdf:li>
               <rdf:li>drug abuse</rdf:li>
               <rdf:li>label-free quantification</rdf:li>
               <rdf:li>proteomics</rdf:li>
               <rdf:li>cocaine</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
